# Copy this file to `.env` and fill in real values. Never commit `.env`.

PORT=5000

# Local MongoDB instance. Atlas users can paste their connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/geekstober-whiteboard

# Long random string, for example the output of: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated exact browser origins. Development also permits HTTP loopback
# origins on any port so Vite can use its next available port when 5173 is busy.
CLIENT_URL=http://localhost:5173

NODE_ENV=development
